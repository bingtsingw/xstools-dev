{
  "name": "@xstools-dev/mono",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "build": "turbo run build",
    "changeset-add": "changeset add",
    "changeset-publish": "npm run check-publish && changeset publish",
    "changeset-version": "changeset version",
    "check-mono": "sherif",
    "check-publish": "npm run build && npm run format && npm run lint:js && npm run check-type && npm run test",
    "check-type": "turbo run check-type",
    "clean": "del **/dist **/.build **/.swc **/.turbo **/node_modules !node_modules",
    "commit": "czg",
    "dev": "turbo run dev",
    "fmt": "prettier . --check",
    "fmt:fix": "prettier . --write",
    "lint": "turbo run lint:js",
    "lint:fix": "turbo run lint:js:fix",
    "prepare": "vp hooks enable",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@xstools-dev/cli-toolkit": "workspace:^",
    "@xstools-dev/eslint-config": "workspace:^",
    "@xstools-dev/prettier-config": "workspace:^",
    "typescript": "5.9.3",
    "vite-plus": "^0.3.0"
  },
  "prettier": "@xstools-dev/prettier-config/base",
  "packageManager": "pnpm@10.34.5"
}
